{
  "apiVersion": 1,
  "title": "Kubernetes Cluster Dashboard",
  "uid": "kubernetes-cluster-dashboard",
  "tags": [
    "kubernetes",
    "cluster",
    "infrastructure"
  ],
  "timezone": "browser",

  "panels": [

    {
      "id": 1,
      "title": "Cluster Nodes",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_node_info)",
          "legendFormat": "Nodes"
        }
      ]
    },

    {
      "id": 2,
      "title": "Node CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    },

    {
      "id": 3,
      "title": "Node Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },

    {
      "id": 4,
      "title": "Node Disk Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(1 - node_filesystem_avail_bytes{fstype!=\"tmpfs\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\"}) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },

    {
      "id": 5,
      "title": "Pod Count",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_info)",
          "legendFormat": "Pods"
        }
      ]
    },

    {
      "id": 6,
      "title": "Pods By Namespace",
      "type": "timeseries",
      "targets": [
        {
          "expr": "count(kube_pod_info) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },

    {
      "id": 7,
      "title": "Pod Restart Count",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total) by (namespace,pod)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },

    {
      "id": 8,
      "title": "Container CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) by (namespace,pod)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },

    {
      "id": 9,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) by (namespace,pod)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },

    {
      "id": 10,
      "title": "Deployment Availability",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available",
          "legendFormat": "{{namespace}}/{{deployment}}"
        }
      ]
    },

    {
      "id": 11,
      "title": "Failed Pods",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Failed\"})"
        }
      ]
    },

    {
      "id": 12,
      "title": "Pending Pods",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Pending\"})"
        }
      ]
    }
  ]
}